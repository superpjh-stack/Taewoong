# ─────────────────────────────────────────
# 태웅 AI-MES 환경변수 템플릿
# .env.example 을 복사해 .env (로컬/Docker) 로 사용
#
# Docker Compose 사용 시:
#   - 컨테이너 간 통신은 호스트명(db, redis)으로 이루어지므로
#     compose 가 DATABASE_URL / REDIS_URL 을 자동 오버라이드한다.
#   - 아래 값은 호스트(localhost)에서 직접 pnpm dev 실행 시 사용.
# ─────────────────────────────────────────

# Node
NODE_ENV=development

# ─── Database ───────────────────────────
# 로컬 직접 실행: localhost / Docker 내부: db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taewung_mes
POSTGRES_USER=mes_user
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgresql://mes_user:your_password_here@localhost:5432/taewung_mes

# ─── Redis ──────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── Auth ───────────────────────────────
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Core API ───────────────────────────
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ─── AI Service (FastAPI) ───────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=internal_service_key

# ─── Storage (MinIO) ────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MILLCERTS=mill-certificates
MINIO_BUCKET_REPORTS=inspection-reports

# ─── OpenAI / LLM ───────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# ─── Next.js (Web) ──────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXTAUTH_SECRET=change_this_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ─── Monitoring ─────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug
